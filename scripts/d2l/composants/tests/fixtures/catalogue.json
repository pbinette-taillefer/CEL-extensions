  "entries": [
    {
      "id": "med-nbsp",
      "label": "Espace insécable",
      "type": "med",
      "name": "nbsp",
      "html": "<span class=\"mceNonEditable\" data-component=\"nbsp\"\n              data-component-type=\"med\">&nbsp;</span>",
      "description": "Espace insécable : empêche le passage à la ligne à cet endroit (typographie française, avant « : », « ; », « ? », « ! », « » » et après « « »). Marqueur vide côté éditeur (un fin trait ambre) : on le colle à la place de l'espace à rendre insécable, sans doubler l'espace. Côté apprenant, le composant rend un . Dans Creator+, copiez plutôt le caractère brut avec le bouton prévu à cet effet."
    },
    {
      "id": "med-artefact",
      "label": "Document Office",
      "type": "med",
      "name": "artefact",
      "html": "<span data-component=\"artefact\" data-component-type=\"med\"\n              data-prop-type=\"docx\" class=\"mceNonEditable\">\n              <span data-slot=\"titreartefact\" class=\"mceEditable\" data-placeholder=\"Insérer un titre\">Document du\n                cours</span>\n              <span data-slot=\"gsuitelink\" class=\"mceEditable\"\n                data-placeholder=\"Insérer un lien\">https://docs.google.com/document/d/exemple</span>\n              <span data-slot=\"o365link\" class=\"mceEditable\"\n                data-placeholder=\"Insérer un lien\">https://m365.cloud.microsoft/launch/word?file=exemple</span> </span>",
      "description": "Document Word offert dans Google Docs et Microsoft 365. Également disponible en variante PDF."
    },
    {
      "id": "med-artefact-pdf",
      "label": "Document PDF",
      "type": "med",
      "name": "artefact",
      "html": "<span data-component=\"artefact\" data-component-type=\"med\"\n              data-prop-type=\"pdf\" class=\"mceNonEditable\">\n              <span data-slot=\"titreartefact\" class=\"mceEditable\" data-placeholder=\"Insérer un titre\">Document PDF du\n                cours</span>\n              <span data-slot=\"pdflink\" class=\"mceEditable\"\n                data-placeholder=\"Insérer un lien PDF\">https://example.com/document.pdf</span> </span>",
      "description": "Variante PDF du composant artefact."
    },
    {
      "id": "med-boite",
      "label": "Boîte",
      "type": "med",
      "name": "boite-sans-creator",
      "html": "<div data-component=\"boite-sans-creator\" data-component-type=\"med\"\n            class=\"mceNonEditable\">\n            <div data-slot=\"default\" class=\"mceEditable\">\n              <p><strong>À retenir :</strong> remplacez ce texte par le contenu souhaité.</p>\n            </div>\n          </div>",
      "description": "Encadré simple pour regrouper un contenu ou un artefact."
    },
    {
      "id": "med-forum",
      "label": "Forum",
      "type": "med",
      "name": "forum",
      "html": "<div data-component=\"forum\" data-component-type=\"med\" class=\"mceNonEditable\">\n            <div data-slot=\"content\" class=\"mceEditable\">\n              <p>\n                Partagez votre réflexion, puis réagissez avec bienveillance à la publication d’une\n                autre personne.\n              </p>\n            </div>\n            <span data-slot=\"forumLink\" class=\"mceEditable\"\n              data-placeholder=\"Insérer un lien\">https://example.com/forum</span>\n          </div>",
      "description": "Consigne accompagnée d’un bouton vers un forum D2L."
    },
    {
      "id": "med-fullimg",
      "label": "Image plein écran",
      "type": "med",
      "name": "fullimg",
      "html": "<div data-component=\"fullimg\" data-component-type=\"med\"\n            data-prop-fullscreen=\"false\" class=\"mceNonEditable\">\n            <span data-slot=\"image\" class=\"mceEditable\" data-placeholder=\"Insérer une image\">\n              <img src=\"https://picsum.photos/id/1015/1200/600\" alt=\"Paysage montagneux traversé par une rivière\">\n            </span>\n            <span data-slot=\"da\" class=\"mceEditable\" data-placeholder=\"Insérer le droit d’auteur\">© Image de\n              démonstration</span>\n          </div>",
      "description": "Image large avec texte alternatif, droit d’auteur et plein écran."
    },
    {
      "id": "med-h5p",
      "label": "Activité H5P",
      "type": "med",
      "name": "h5p",
      "html": "<div data-component=\"h5p\" data-component-type=\"med\" class=\"mceNonEditable\">\n            <span data-slot=\"id\" class=\"mceEditable\" data-placeholder=\"Insérer un identifiant\"></span>\n            <span data-slot=\"title\" class=\"mceEditable\" data-placeholder=\"Insérer un titre\">Activité interactive</span>\n            <span data-slot=\"da\" class=\"mceEditable\" data-placeholder=\"Insérer le droit d’auteur\">© Centre\n              franco</span>\n          </div>",
      "description": "Activité H5P intégrée à partir de son identifiant."
    },
    {
      "id": "med-ifram",
      "label": "Intégration iframe",
      "type": "med",
      "name": "ifram",
      "html": "<div data-component=\"ifram\" data-component-type=\"med\" data-prop-fullscreen=\"true\"\n            class=\"mceNonEditable\">\n            <span data-slot=\"src\" class=\"mceEditable\"\n              data-placeholder=\"Insérer un lien\">https://example.com/activite</span>\n            <span data-slot=\"title\" class=\"mceEditable\" data-placeholder=\"Insérer un titre\">Activité interactive</span>\n            <span data-slot=\"da\" class=\"mceEditable\" data-placeholder=\"Insérer le droit d’auteur\">© Activité de\n              démonstration</span>\n          </div>",
      "description": "Activité ou page externe intégrée dans un cadre adaptatif."
    },
    {
      "id": "med-jwplayer",
      "label": "Lecteur JWPlayer",
      "type": "med",
      "name": "jwplayer",
      "html": "<div data-component=\"jwplayer\" data-component-type=\"med\"\n            data-prop-hidedescription=\"false\" data-prop-forcevideoplayer=\"false\" class=\"mceNonEditable\">\n            <span data-slot=\"mediaids\" class=\"mceEditable\" data-placeholder=\"Insérer un identifiant\">fNZb4Lwv</span>\n            <span data-slot=\"copyrights\" class=\"mceEditable\" data-placeholder=\"Insérer le droit d’auteur\">©\n              Vidéo de démonstration</span>\n          </div>",
      "description": "Lecteur vidéo alimenté par un identifiant JW Player."
    },
    {
      "id": "med-medialink",
      "label": "Carte de ressource",
      "type": "med",
      "name": "medialink",
      "html": "<div data-component=\"medialink\" data-component-type=\"med\"\n            class=\"mceNonEditable\">\n            <span data-slot=\"title\" class=\"mceEditable\" data-placeholder=\"Insérer un titre\">Ressource\n              complémentaire</span>\n            <span data-slot=\"href\" class=\"mceEditable\"\n              data-placeholder=\"Insérer un lien\">https://example.com/ressource</span>\n            <span data-slot=\"image\" class=\"mceEditable\" data-placeholder=\"Insérer une image\">\n              <img src=\"https://picsum.photos/id/20/1000/500\" alt=\"Carnet ouvert sur une table\" />\n            </span>\n            <span data-slot=\"da\" class=\"mceEditable\" data-placeholder=\"Insérer le droit d’auteur\">© Image de\n              démonstration</span>\n            <span data-slot=\"default\" class=\"mceEditable\" data-placeholder=\"Insérer du texte\">Consulter la ressource\n              complémentaire</span>\n          </div>",
      "description": "Carte illustrée qui mène vers une ressource externe."
    },
    {
      "id": "med-mediaimage-image",
      "label": "Image et texte",
      "type": "med",
      "name": "mediaimage",
      "html": "<div data-component=\"mediaimage\" data-component-type=\"med\"\n                data-prop-media-position=\"left\" data-prop-media-size=\"1/3\" data-prop-media-type=\"image\"\n                data-prop-fullscreen=\"false\" class=\"mceNonEditable\">\n                <section class=\"d2l-cplus-layout hidden\" tabindex=\"-1\"></section>\n                <span data-slot=\"image\" class=\"mceEditable\" data-placeholder=\"Insérer une image\">\n                  <img src=\"https://picsum.photos/id/1015/900/600\"\n                    alt=\"Rivière qui serpente au pied de montagnes boisées\" />\n                </span>\n                <span data-slot=\"da\" class=\"mceEditable\" data-placeholder=\"Insérer le droit d’auteur\">\n                  © Image de démonstration\n                </span>\n                <div data-slot=\"content\" class=\"mceEditable\">\n                  <p class=\"font-bold\">Observer le paysage</p>\n                  <p>Repère les reliefs qui entourent la rivière et explique comment le paysage guide son parcours.</p>\n                </div>\n              </div>",
      "description": "Image ou vidéo d’un côté, texte de l’autre, dans une grille native D2L. Le média peut être à gauche ou à droite et occuper un tiers, la moitié ou deux tiers."
    },
    {
      "id": "med-mediaimage-video",
      "label": "Vidéo et texte",
      "type": "med",
      "name": "mediaimage",
      "html": "<div data-component=\"mediaimage\" data-component-type=\"med\"\n                data-prop-media-position=\"left\" data-prop-media-size=\"1/3\" data-prop-media-type=\"video\"\n                class=\"mceNonEditable\">\n                <section class=\"d2l-cplus-layout hidden\" tabindex=\"-1\"></section>\n                <span data-slot=\"mediaids\" class=\"mceEditable\" data-placeholder=\"Insérer un identifiant JWPlayer\">\n                  fNZb4Lwv\n                </span>\n                <span data-slot=\"da\" class=\"mceEditable\" data-placeholder=\"Insérer le droit d’auteur\">\n                  © Vidéo de démonstration\n                </span>\n                <div data-slot=\"content\" class=\"mceEditable\">\n                  <p class=\"font-bold\">Comprendre le courant</p>\n                  <p>Visionne la vidéo, puis décris les changements de vitesse de l’eau observés.</p>\n                </div>\n              </div>",
      "description": "Image ou vidéo d’un côté, texte de l’autre, dans une grille native D2L. Le média peut être à gauche ou à droite et occuper un tiers, la moitié ou deux tiers."
    },
    {
      "id": "med-modal",
      "label": "Bouton et fenêtre modale",
      "type": "med",
      "name": "modalbox",
      "html": "<span data-component=\"modalbtn\" data-component-type=\"med\" data-prop-modalid=\"\"\n            class=\"mceNonEditable\">\n            <span data-slot=\"default\" class=\"mceEditable\" data-placeholder=\"Insérer le texte du bouton\">Ouvrir\n              la fenêtre</span>\n          </span><div data-component=\"modalbox\" data-component-type=\"med\" data-prop-modalid=\"\"\n            data-prop-titletag=\"h2\" data-prop-size=\"max-w-lg\" class=\"mceNonEditable\">\n            <div data-slot=\"titre\" class=\"mceEditable\">\n              Titre de la fenêtre\n            </div>\n            <div data-slot=\"contenu\" class=\"mceEditable\">\n              <p>Remplacez ce texte par le contenu à afficher.</p>\n            </div>\n          </div>",
      "uniqueAttributes": [
        "data-prop-modalid"
      ],
      "description": "Bouton et fenêtre modale à copier ensemble avec le même identifiant."
    },
    {
      "id": "med-grid-left",
      "label": "Colonnes 1/3 – 2/3",
      "type": "med",
      "name": "grid",
      "html": "<div data-component=\"grid\" data-component-type=\"med\" data-prop-type=\"left\"\n              class=\"mceNonEditable\">\n              <section class=\"d2l-cplus-layout hidden\" tabindex=\"-1\"></section>\n              <div data-slot=\"column1\" class=\"mceEditable\">\n                <p>Colonne 1</p>\n              </div>\n              <div data-slot=\"column2\" class=\"mceEditable\">\n                <p>Colonne 2</p>\n              </div>\n            </div>",
      "description": "Grille adaptative utilisant directement la mise en page native de D2L."
    },
    {
      "id": "med-grid-right",
      "label": "Colonnes 2/3 – 1/3",
      "type": "med",
      "name": "grid",
      "html": "<div data-component=\"grid\" data-component-type=\"med\"\n              data-prop-type=\"right\" class=\"mceNonEditable\">\n              <section class=\"d2l-cplus-layout hidden\" tabindex=\"-1\"></section>\n              <div data-slot=\"column1\" class=\"mceEditable\">\n                <p>Colonne 1</p>\n              </div>\n              <div data-slot=\"column2\" class=\"mceEditable\">\n                <p>Colonne 2</p>\n              </div>\n            </div>",
      "description": "Grille adaptative utilisant directement la mise en page native de D2L."
    },
    {
      "id": "med-grid-equal",
      "label": "Colonnes 1/2 – 1/2",
      "type": "med",
      "name": "grid",
      "html": "<div data-component=\"grid\" data-component-type=\"med\"\n              data-prop-type=\"equal\" class=\"mceNonEditable\">\n              <section class=\"d2l-cplus-layout hidden\" tabindex=\"-1\"></section>\n              <div data-slot=\"column1\" class=\"mceEditable\">\n                <p>Colonne 1</p>\n              </div>\n              <div data-slot=\"column2\" class=\"mceEditable\">\n                <p>Colonne 2</p>\n              </div>\n            </div>",
      "description": "Grille adaptative utilisant directement la mise en page native de D2L."
    },
    {
      "id": "med-grid-triple",
      "label": "Trois colonnes",
      "type": "med",
      "name": "grid",
      "html": "<div data-component=\"grid\" data-component-type=\"med\"\n              data-prop-type=\"triple\" class=\"mceNonEditable\">\n              <section class=\"d2l-cplus-layout hidden\" tabindex=\"-1\"></section>\n              <div data-slot=\"column1\" class=\"mceEditable\">\n                <p>Colonne 1</p>\n              </div>\n              <div data-slot=\"column2\" class=\"mceEditable\">\n                <p>Colonne 2</p>\n              </div>\n              <div data-slot=\"column3\" class=\"mceEditable\">\n                <p>Colonne 3</p>\n              </div>\n            </div>",
      "description": "Grille adaptative utilisant directement la mise en page native de D2L."
    },
    {
      "id": "med-storyline",
      "label": "Activité Storyline",
      "type": "med",
      "name": "storyline",
      "html": "<div data-component=\"storyline\" data-component-type=\"med\"\n            data-prop-aspectratio=\"16/9\" data-prop-fullscreen=\"true\" class=\"mceNonEditable\">\n            <span data-slot=\"mamid\" class=\"mceEditable\" data-placeholder=\"Insérer le MAM ID\"></span>\n            <span data-slot=\"title\" class=\"mceEditable\" data-placeholder=\"Insérer un titre\">Activité interactive</span>\n          </div>",
      "description": "Activité Articulate Storyline adaptative avec contrôle plein écran."
    },
    {
      "id": "med-tableau",
      "label": "Tableau",
      "type": "med",
      "name": "tableau",
      "html": "<div data-component=\"tableau\" data-component-type=\"med\" class=\"mceNonEditable\">\n            <div data-slot=\"default\" class=\"mceEditable\">\n              <table>\n                <caption class=\"sr-only\">\n                  Évolution du nombre d’abonnements\n                </caption>\n                <thead>\n                  <tr>\n                    <th scope=\"col\" style=\"text-align: center;\"><strong>Temps (semaines)</strong></th>\n                    <th scope=\"col\" style=\"text-align: center;\"><strong>Nombre d’abonnements</strong></th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr>\n                    <td style=\"text-align: center;\"><p>0</p></td>\n                    <td style=\"text-align: center;\"><p>1 200</p></td>\n                  </tr>\n                  <tr>\n                    <td style=\"text-align: center;\"><p>4</p></td>\n                    <td style=\"text-align: center;\"><p>1 313</p></td>\n                  </tr>\n                  <tr>\n                    <td style=\"text-align: center;\"><p>8</p></td>\n                    <td style=\"text-align: center;\"><p>1 437</p></td>\n                  </tr>\n                  <tr>\n                    <td style=\"text-align: center;\"><p>12</p></td>\n                    <td style=\"text-align: center;\"><p>1 572</p></td>\n                  </tr>\n                  <tr>\n                    <td style=\"text-align: center;\"><p>20</p></td>\n                    <td style=\"text-align: center;\"><p>1 882</p></td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n          </div>",
      "description": "Mise en forme adaptative d’un tableau HTML accessible."
    }
  ]
}
